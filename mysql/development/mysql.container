[Unit]
Description=MySQL

[Container]
Image=docker.io/library/mysql:8.4
AutoUpdate=registry
Environment=MYSQL_ALLOW_EMPTY_PASSWORD=yes
Volume=mysql-data.volume:/var/lib/mysql:rw
Network=mysql.network
# Other applications reach it as mysql on the systemd-mysql network.
NetworkAlias=mysql
# Only on this machine, for tools on the host.
PublishPort=127.0.0.1:3307:3306
Notify=healthy
HealthStartupCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthStartupInterval=2s
HealthStartupTimeout=5s
HealthCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
