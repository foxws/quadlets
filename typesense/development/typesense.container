[Unit]
Description=Typesense

[Container]
Image=docker.io/typesense/typesense:30.2
AutoUpdate=registry
Environment=TYPESENSE_DATA_DIR=/data
Environment=TYPESENSE_API_KEY=pods
Environment=TYPESENSE_ENABLE_CORS=true
Volume=typesense-data.volume:/data:rw
Network=typesense.network
# Other applications reach it as typesense on the systemd-typesense network.
NetworkAlias=typesense
# Only on this machine, for tools on the host.
PublishPort=127.0.0.1:8108:8108

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
