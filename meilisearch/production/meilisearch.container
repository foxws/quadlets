[Unit]
Description=Meilisearch

[Container]
Image=docker.io/getmeili/meilisearch:v1.42
AutoUpdate=registry
Environment=MEILI_ENV=production
Secret=meilisearch-master-key,type=env,target=MEILI_MASTER_KEY
Volume=meilisearch-data.volume:/meili_data:rw
Network=meilisearch.network
# Other applications reach it as meilisearch on the systemd-meilisearch network.
NetworkAlias=meilisearch

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
